# Copier ce fichier en .env (jamais commité) puis adapter les valeurs.

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Base locale déjà créée avec l'ancienne configuration ? Gardez ces trois
# valeurs identiques à l'ancienne (keeppace_user / keeppace_password /
# keeppace_dev) : PostgreSQL ne relit pas ces variables sur un volume existant.
POSTGRES_USER=keeppace_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=keeppace_dev

# ─── Application ─────────────────────────────────────────────────────────────
# Clé de signature des sessions. Obligatoire en production (32 caractères min.).
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-with-a-long-random-value

# Durée de session en minutes (défaut : 7 jours).
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Mettre à false pour fermer les inscriptions une fois vos comptes créés.
# ALLOW_REGISTRATION=true

# Origines autorisées à appeler l'API depuis un autre domaine (virgules).
# Inutile si le frontend passe par /api (cas par défaut).
# CORS_ORIGINS=https://keeppace.example.com

# Cookie de session réservé à HTTPS. Par défaut : true en production.
# COOKIE_SECURE=true

# Fuseau horaire pour « aujourd'hui » (statuts de présence, relances).
# TIMEZONE=Europe/Paris
